# ==============================================================================
# 🤖 LLM & Embedding Providers
# ==============================================================================
# Choose your LLM provider: "gemini", "openai", or "groq"
LLM_PROVIDER=gemini

# Choose your embedding provider: "google" or "openai"
EMBEDDING_PROVIDER=google

# Your Google API Key (Required for Gemini LLM and Google Embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# Specific Google Model to use (e.g., gemini-1.5-flash, gemini-1.5-pro)
GOOGLE_MODEL=gemini-1.5-flash

# OpenAI API Key (Required for DeepEval evaluation "judge" and fallback)
OPENAI_API_KEY=your_openai_api_key_here


# ==============================================================================
# 🗄️ Qdrant Vector Store Settings
# ==============================================================================
# Mode: "memory" (volatile, fast), "local" (saves to disk), or "cloud" (Qdrant Cloud)
QDRANT_MODE=local

# Local path (only used if QDRANT_MODE=local)
QDRANT_LOCAL_PATH=./qdrant_data

# Cloud settings (only used if QDRANT_MODE=cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Name of the collection in Qdrant
QDRANT_COLLECTION_NAME=AbhiAbhiDilmera


# ==============================================================================
# 🔄 Retrieval & Reranking Settings
# ==============================================================================
# Enable or disable the Cohere reranker ("true" or "false")
USE_RERANKER=true

# Your Cohere API Key (Required if USE_RERANKER=true)
COHERE_API_KEY=your_cohere_api_key_here

# Cohere reranking model to use
COHERE_RERANK_MODEL=rerank-english-v3.0

# Number of chunks to fetch initially for hybrid search
HYBRID_FETCH_K=20

# Final number of chunks to return after reranking
DEFAULT_RETRIEVAL_K=4


# ==============================================================================
# 🛠️ Miscellaneous / Debugging
# ==============================================================================
# Set to "true" to use mock data instead of real API calls (for testing)
USE_MOCKS=false